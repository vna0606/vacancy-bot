# Telegram Bot Token (тот же токен, что и в 01-bot)
TELEGRAM_BOT_TOKEN=

# Turso database URL
TURSO_URL=

# Turso auth token
TURSO_TOKEN=

# Час отправки уведомлений (UTC, 0-23), используется если запуск через APScheduler
NOTIFY_HOUR=9

# За сколько часов назад брать вакансии
VACANCIES_LOOKBACK_HOURS=24

# 1 (по умолчанию) — рассылка идёт ТОЛЬКО на ADMIN_TG_ID (тестовый режим).
# Переключить на 0 только после ручной проверки тестового прогона.
TEST_MODE=1

# tg_id, на который уходит рассылка при TEST_MODE=1
ADMIN_TG_ID=
